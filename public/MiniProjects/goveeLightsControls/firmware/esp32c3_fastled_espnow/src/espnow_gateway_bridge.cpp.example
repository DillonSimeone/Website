// ==============================================================================
// ESP-NOW Wi-Fi to ESP-NOW UDP Gateway Bridge (Optional Example)
// ==============================================================================
// Flash this firmware to ONE ESP32 that is connected to your local Wi-Fi.
// It listens on UDP port 4210 for commands from GoveeTrayControl (PC), and
// broadcasts them instantaneously to all battery/node ESP32-C3s over ESP-NOW!
// ==============================================================================

#if 0 // Change to 1 if you want to build this bridge firmware

#include <Arduino.h>
#include <WiFi.h>
#include <WiFiUdp.h>
#include <esp_now.h>
#include "espnow_protocol.h"

// Wi-Fi Credentials
const char* ssid = "YOUR_WIFI_SSID";
const char* password = "YOUR_WIFI_PASSWORD";

WiFiUDP udp;
const uint8_t broadcastAddress[] = {0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF};

void setup() {
    Serial.begin(115200);
    delay(1000);

    // Connect to Wi-Fi
    WiFi.mode(WIFI_AP_STA);
    WiFi.begin(ssid, password);
    while (WiFi.status() != WL_CONNECTED) {
        delay(500);
        Serial.print(".");
    }
    Serial.printf("\nConnected! Gateway IP: %s\n", WiFi.localIP().toString().c_str());

    // Initialize ESP-NOW
    if (esp_now_init() != ESP_OK) {
        Serial.println("Error initializing ESP-NOW");
        return;
    }

    // Register broadcast peer
    esp_now_peer_info_t peerInfo = {};
    memcpy(peerInfo.peer_addr, broadcastAddress, 6);
    peerInfo.channel = 0;
    peerInfo.encrypt = false;
    esp_now_add_peer(&peerInfo);

    // Start UDP listening on port 4210
    udp.begin(4210);
    Serial.println("Listening on UDP port 4210...");
}

void loop() {
    int packetSize = udp.parsePacket();
    if (packetSize >= sizeof(EspNowLightPacket)) {
        EspNowLightPacket packet;
        udp.read((char*)&packet, sizeof(packet));

        // Forward immediately via ESP-NOW broadcast
        esp_now_send(broadcastAddress, (uint8_t*)&packet, sizeof(packet));
        Serial.printf("[Gateway] Forwarded packet to ESP-NOW (Pattern: %d, Bri: %d)\n", 
                      packet.pattern, packet.brightness);
    }
    delay(2);
}

#endif
