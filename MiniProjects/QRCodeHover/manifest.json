{
  "manifest_version": 3,
  "name": "Asset to QR Code Panel",
  "version": "1.0.1",
  "description": "Hover over any link or image and press Ctrl+Shift to spawn a floating QR panel. Click to copy, or let it fade.",
  "permissions": ["clipboardWrite"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lib/qrcode.min.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "asset-to-qr@dillonsimeone.local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
