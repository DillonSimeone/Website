<?xml version='1.0' encoding='utf-8'?>
<interface version="1.1">
  <object class="ttk.Frame" id="top_frame">
    <property name="height">250</property>
    <property name="padding">15</property>
    <property name="width">350</property>
    <layout manager="grid">
      <property name="column">0</property>
      <property name="propagate">True</property>
      <property name="row">0</property>
      <property name="sticky">nsew</property>
      <property type="col" id="0" name="weight">1</property>
      <property type="row" id="0" name="weight">1</property>
    </layout>
    <child>
      <object class="ttk.Label" id="title_label">
        <property name="font">{Arial} 16 {bold}</property>
        <property name="text"
          translatable="yes">Filament Mass to Length</property>
        <layout manager="grid">
          <property name="column">0</property>
          <property name="propagate">True</property>
          <property name="row">0</property>
          <property type="col" id="0" name="weight">1</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="ttk.Label" id="desc_label">
        <property name="padding">5</property>
        <property name="text" translatable="yes"
          >Estimate printable 1.75 mm PLA length from spool weight.</property>
        <layout manager="grid">
          <property name="column">0</property>
          <property name="propagate">True</property>
          <property name="row">1</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="ttk.Frame" id="input_frame">
        <property name="padding">10</property>
        <layout manager="grid">
          <property name="column">0</property>
          <property name="propagate">True</property>
          <property name="row">2</property>
          <property type="col" id="0" name="weight">1</property>
        </layout>
        <child>
          <object class="ttk.Label" id="mass_label">
            <property name="text"
              translatable="yes">Filament Mass (grams):</property>
            <layout manager="grid">
              <property name="column">0</property>
              <property name="padx">5</property>
              <property name="pady">5</property>
              <property name="propagate">True</property>
              <property name="row">0</property>
              <property name="sticky">e</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="ttk.Entry" id="mass_entry">
            <property name="width">12</property>
            <layout manager="grid">
              <property name="column">1</property>
              <property name="padx">5</property>
              <property name="pady">5</property>
              <property name="propagate">True</property>
              <property name="row">0</property>
              <property name="sticky">w</property>
            </layout>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="ttk.Button" id="calc_button">
        <property name="command" type="command"
          cbtype="simple">calculate</property>
        <property name="text" translatable="yes">Calculate Length</property>
        <layout manager="grid">
          <property name="column">0</property>
          <property name="pady">8</property>
          <property name="propagate">True</property>
          <property name="row">3</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="ttk.Separator" id="separator1">
        <property name="orient">horizontal</property>
        <layout manager="grid">
          <property name="column">0</property>
          <property name="pady">10</property>
          <property name="propagate">True</property>
          <property name="row">4</property>
          <property name="sticky">ew</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="ttk.Frame" id="result_frame">
        <property name="padding">5</property>
        <layout manager="grid">
          <property name="column">0</property>
          <property name="propagate">True</property>
          <property name="row">5</property>
          <property type="col" id="0" name="weight">1</property>
        </layout>
        <child>
          <object class="ttk.Label" id="result_header">
            <property name="font">{Arial} 11 {bold}</property>
            <property name="padding">4</property>
            <property name="text"
              translatable="yes">Calculated Length:</property>
            <layout manager="grid">
              <property name="column">0</property>
              <property name="columnspan">2</property>
              <property name="propagate">True</property>
              <property name="row">0</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="ttk.Label" id="meters_label">
            <property name="text"
              translatable="yes">Length (Meters):</property>
            <layout manager="grid">
              <property name="column">0</property>
              <property name="padx">5</property>
              <property name="pady">4</property>
              <property name="propagate">True</property>
              <property name="row">1</property>
              <property name="sticky">e</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="ttk.Entry" id="meters_entry">
            <property name="state">readonly</property>
            <property
              name="textvariable">string:meters_entry_variable</property>
            <property name="width">16</property>
            <layout manager="grid">
              <property name="column">1</property>
              <property name="padx">5</property>
              <property name="pady">4</property>
              <property name="propagate">True</property>
              <property name="row">1</property>
              <property name="sticky">w</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="ttk.Label" id="feet_label">
            <property name="text" translatable="yes">Length (Feet):</property>
            <layout manager="grid">
              <property name="column">0</property>
              <property name="padx">5</property>
              <property name="pady">4</property>
              <property name="propagate">True</property>
              <property name="row">2</property>
              <property name="sticky">e</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="ttk.Entry" id="feet_entry">
            <property name="state">readonly</property>
            <property name="textvariable">string:feet_entry_variable</property>
            <property name="width">16</property>
            <layout manager="grid">
              <property name="column">1</property>
              <property name="padx">5</property>
              <property name="pady">4</property>
              <property name="propagate">True</property>
              <property name="row">2</property>
              <property name="sticky">w</property>
            </layout>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
