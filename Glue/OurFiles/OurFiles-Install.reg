Windows Registry Editor Version 5.00

; =======================================================================
; ☭ OUR FILES, COMRADE — Seize the Means of Production (Take Ownership)
; =======================================================================

; 1. Individual Files
[HKEY_CLASSES_ROOT\*\shell\runas]
@="Seize the Means of Production (Take Ownership)"
"HasLUAShield"=""
"NoWorkingDirectory"=""
"Icon"="imageres.dll,-5323"

[HKEY_CLASSES_ROOT\*\shell\runas\command]
@="cmd.exe /c \"\"F:\\Github\\Website\\public\\Glue\\OurFiles\\SeizeTheMeans.bat\" \"%1\"\""

; 2. Folders / Directories
[HKEY_CLASSES_ROOT\Directory\shell\runas]
@="Seize the Means of Production (Take Ownership)"
"HasLUAShield"=""
"NoWorkingDirectory"=""
"Icon"="imageres.dll,-5323"

[HKEY_CLASSES_ROOT\Directory\shell\runas\command]
@="cmd.exe /c \"\"F:\\Github\\Website\\public\\Glue\\OurFiles\\SeizeTheMeans.bat\" \"%1\"\""

; 3. Directory Background (Empty space inside open folder)
[HKEY_CLASSES_ROOT\Directory\Background\shell\runas]
@="Seize the Means of Production (Take Ownership)"
"HasLUAShield"=""
"NoWorkingDirectory"=""
"Icon"="imageres.dll,-5323"

[HKEY_CLASSES_ROOT\Directory\Background\shell\runas\command]
@="cmd.exe /c \"\"F:\\Github\\Website\\public\\Glue\\OurFiles\\SeizeTheMeans.bat\" \"%V\"\""

; Clean up legacy custom verb keys if present
[-HKEY_CLASSES_ROOT\*\shell\OurFiles]
[-HKEY_CLASSES_ROOT\Directory\shell\OurFiles]
[-HKEY_CLASSES_ROOT\Directory\Background\shell\OurFiles]
